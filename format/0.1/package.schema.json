{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harmonomicon activity package 0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "version",
    "content",
    "provenance",
    "participants",
    "requires",
    "behavior"
  ],
  "properties": {
    "format": {
      "const": "harmonomicon.activity-package/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "title",
        "summary",
        "setup",
        "prompt",
        "participant",
        "completion",
        "access"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "participant": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "credit",
        "rights"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original",
            "adaptation"
          ]
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https?://"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "adaptation"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "sourceUrl"
        ]
      }
    },
    "participants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 2
        },
        "max": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "requires": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity@1",
          "serial_events@1",
          "durable_state@1",
          "private_views@1",
          "clock@1",
          "text@1",
          "image_ref@1"
        ]
      }
    },
    "behavior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "medium",
            "allowPromptOverride"
          ],
          "properties": {
            "contract": {
              "const": "timed_collection@1"
            },
            "medium": {
              "enum": [
                "text",
                "image_ref"
              ]
            },
            "allowPromptOverride": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "medium",
            "steps",
            "allowPromptOverride"
          ],
          "properties": {
            "contract": {
              "const": "sequential_handoff@1"
            },
            "medium": {
              "enum": [
                "text",
                "image_ref"
              ]
            },
            "steps": {
              "type": "integer",
              "minimum": 2
            },
            "allowPromptOverride": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
