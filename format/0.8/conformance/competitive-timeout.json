{
  "package": "../examples/two-offer-story-chain.json",
  "capabilities": [
    "identity@1",
    "serial_events@1",
    "durable_state@1",
    "private_views@1",
    "clock@1",
    "text@1"
  ],
  "contracts": [
    "competitive_handoff@1"
  ],
  "instance": {
    "createdAt": 0,
    "organizer": "host",
    "participants": [
      "a",
      "b",
      "c",
      "d"
    ],
    "startsAt": 10,
    "routes": [
      [
        [
          "a",
          "b"
        ],
        [
          "c",
          "d"
        ]
      ],
      [
        [
          "c",
          "d"
        ],
        [
          "a",
          "b"
        ]
      ],
      [
        [
          "a",
          "d"
        ],
        [
          "b",
          "c"
        ]
      ]
    ]
  },
  "events": [
    {
      "event": {
        "eventId": "open",
        "type": "tick",
        "actor": "system",
        "at": 10,
        "payload": {}
      },
      "outcome": "accepted"
    },
    {
      "event": {
        "eventId": "timeout1",
        "type": "tick",
        "actor": "system",
        "at": 60010,
        "payload": {}
      },
      "outcome": "accepted",
      "views": [
        {
          "actor": "a",
          "expect": {
            "phase": "open",
            "step": 1,
            "attempt": 2,
            "deadline": 120010,
            "acceptedCount": 0,
            "ownEntries": []
          }
        },
        {
          "actor": "c",
          "expect": {
            "phase": "open",
            "step": 1,
            "attempt": 2,
            "deadline": 120010,
            "acceptedCount": 0,
            "ownEntries": [],
            "offer": {
              "step": 1,
              "attempt": 2,
              "deadline": 120010,
              "input": "A mysterious package arrived at the station."
            }
          }
        }
      ]
    },
    {
      "event": {
        "eventId": "deadline-loser",
        "type": "submit",
        "actor": "a",
        "at": 60010,
        "payload": {
          "step": 1,
          "attempt": 1,
          "value": "Late"
        }
      },
      "outcome": "rejected"
    },
    {
      "event": {
        "eventId": "c-step1",
        "type": "submit",
        "actor": "c",
        "at": 60011,
        "payload": {
          "step": 1,
          "attempt": 2,
          "value": "Accepted fallback"
        }
      },
      "outcome": "accepted",
      "views": [
        {
          "actor": "d",
          "expect": {
            "phase": "open",
            "step": 2,
            "attempt": 1,
            "deadline": 120011,
            "acceptedCount": 1,
            "ownEntries": [],
            "offer": {
              "step": 2,
              "attempt": 1,
              "deadline": 120011,
              "input": "Accepted fallback"
            }
          }
        }
      ]
    },
    {
      "event": {
        "eventId": "timeout2",
        "type": "tick",
        "actor": "system",
        "at": 120011,
        "payload": {}
      },
      "outcome": "accepted",
      "views": [
        {
          "actor": "a",
          "expect": {
            "phase": "open",
            "step": 2,
            "attempt": 2,
            "deadline": 180011,
            "acceptedCount": 1,
            "ownEntries": [],
            "offer": {
              "step": 2,
              "attempt": 2,
              "deadline": 180011,
              "input": "Accepted fallback"
            }
          }
        }
      ]
    },
    {
      "event": {
        "eventId": "timeout3",
        "type": "tick",
        "actor": "system",
        "at": 180011,
        "payload": {}
      },
      "outcome": "accepted",
      "views": [
        {
          "actor": "host",
          "expect": {
            "phase": "stalled",
            "step": 2,
            "attempt": null,
            "deadline": null,
            "acceptedCount": 1
          }
        },
        {
          "actor": "c",
          "expect": {
            "phase": "stalled",
            "step": 2,
            "attempt": null,
            "deadline": null,
            "acceptedCount": 1,
            "ownEntries": [
              {
                "step": 1,
                "actor": "c",
                "value": "Accepted fallback"
              }
            ]
          }
        }
      ]
    },
    {
      "event": {
        "eventId": "after-stall",
        "type": "submit",
        "actor": "a",
        "at": 180012,
        "payload": {
          "step": 2,
          "attempt": 2,
          "value": "No"
        }
      },
      "outcome": "rejected"
    }
  ]
}
